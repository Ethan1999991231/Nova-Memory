// NovaMemory native resources.
// Keep this file ASCII-only so rc.exe never depends on a code page.

#include "resource.h"

IDI_NOVAMEMORY ICON "NovaMemory.ico"

1 VERSIONINFO
 FILEVERSION 2,3,0,0
 PRODUCTVERSION 2,3,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NovaMemory memory optimizer"
            VALUE "FileVersion", "2.3.0.0"
            VALUE "InternalName", "NovaMemory"
            VALUE "OriginalFilename", "NovaMemory-final.exe"
            VALUE "ProductName", "NovaMemory"
            VALUE "ProductVersion", "2.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
